# Vast template / serverless
SERVERLESS=true
PYWORKER_REPO=https://github.com/YOUR_GITHUB_USER/rosely-wan22-v4-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/YOUR_GITHUB_USER/rosely-wan22-v4-serverless/main/provision.sh

# Model bundle in S3. The archive MUST contain models/... at archive root.
MODEL_S3_BUCKET=your-model-bucket
MODEL_S3_BUNDLE_KEY=serverless/wan22-v4/wan22-enhanced-fp8-v4.tar.zst
MODEL_S3_REGION=us-east-1
MODEL_S3_ENDPOINT_URL=
MODEL_S3_DOWNLOAD_CONCURRENCY=8

# Credentials are optional when the Vast worker has an IAM-compatible role/default credentials.
ROSELY_WAN22_S3_ACCESS_KEY_ID=
ROSELY_WAN22_S3_SECRET_ACCESS_KEY=
ROSELY_WAN22_S3_SESSION_TOKEN=

# Runtime tuning
COMFYUI_ARGS=--lowvram --disable-smart-memory
GENERATION_TIMEOUT_SECONDS=2400
KEEP_LOCAL_OUTPUTS=false

# Optional output upload. Can be the same bucket or a different bucket.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_PREFIX=generated/wan22-v4
S3_PRESIGNED_URL_EXPIRES_SECONDS=3600
